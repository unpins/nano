Read the libmagic database from the binary instead of the host's disk.

nano calls magic_load(cookie, NULL), which looks for the database at the
path compiled into libmagic. A standalone binary cannot count on one there,
so content-based detection (`set magic`) silently found no syntax on a host
without file(1)'s database. magic.mgc now rides the embedded ZIP next to the
system nanorc; it is read once through the same VFS call and handed to
magic_load_buffers(). $MAGIC still wins, and so does libmagic's own lookup
when the embedded copy is missing.

--- a/src/color.c
+++ b/src/color.c
@@ -134,6 +134,55 @@
 
 /* Find a syntax that applies to the current buffer, based upon filename
  * or buffer content, and load and prime this syntax when needed. */
+#ifdef HAVE_LIBMAGIC
+extern FILE *unpin_vfs_fopen(const char *path, const char *mode);
+
+/* Load the magic database that rides inside the binary, read once and kept
+ * for the process: magic_load_buffers() uses the buffer in place. $MAGIC, or
+ * a missing embedded copy, falls back to libmagic's own lookup. */
+static int load_magic(magic_t cookie)
+{
+	static void *buffer = NULL;
+	static size_t size = 0;
+	static bool tried = FALSE;
+
+	if (getenv("MAGIC") == NULL && !tried) {
+		FILE *stream = unpin_vfs_fopen(SYSCONFDIR "/magic.mgc", "rb");
+
+		tried = TRUE;
+		if (stream != NULL) {
+			char chunk[65536];
+			size_t got;
+
+			while ((got = fread(chunk, 1, sizeof(chunk), stream)) > 0) {
+				void *grown = realloc(buffer, size + got);
+
+				if (grown == NULL) {
+					free(buffer);
+					buffer = NULL;
+					size = 0;
+					break;
+				}
+				buffer = grown;
+				memcpy((char *)buffer + size, chunk, got);
+				size += got;
+			}
+			if (ferror(stream)) {
+				free(buffer);
+				buffer = NULL;
+				size = 0;
+			}
+			fclose(stream);
+		}
+	}
+
+	if (getenv("MAGIC") == NULL && buffer != NULL)
+		return magic_load_buffers(cookie, &buffer, &size, 1);
+
+	return magic_load(cookie, NULL);
+}
+#endif
+
 void find_and_prime_applicable_syntax(void)
 {
 	syntaxtype *sntx = NULL;
@@ -192,7 +241,7 @@
 									MAGIC_DEBUG | MAGIC_CHECK |
 #endif
 									MAGIC_ERROR);
-			if (cookie == NULL || magic_load(cookie, NULL) < 0)
+			if (cookie == NULL || load_magic(cookie) < 0)
